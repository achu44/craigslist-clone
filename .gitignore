# ---- Django ----
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/media/
/staticfiles/
/static_root/
# Note: /static/ is source-controlled (your CSS/JS live there).
# Only the collectstatic OUTPUT directory is ignored.

# ---- Testing and coverage ----
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml

