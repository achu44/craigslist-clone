.pytype/
.ruff_cache/

# ---- Editors and IDEs ----
.vscode/
.idea/
*.swp
*.swo
*~
.cursorignore

# ---- Claude Code ----
# Project-level agent config IS committed: .claude/commands/, .claude/agents/,
# and CLAUDE.md are part of the repo's shared setup. Only local state is ignored.
.claude/settings.local.json
CLAUDE.local.md

# ---- OS cruft ----
